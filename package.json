{
  "name": "pharosville",
  "version": "0.1.0",
  "description": "A living stablecoin harbour: live Pharos market signals as boats, a lighthouse, sea and weather in a three.js world.",
  "private": true,
  "license": "MIT",
  "homepage": "https://pharosville.pharos.watch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenBrice/pharosville.git"
  },
  "bugs": {
    "url": "https://github.com/TokenBrice/pharosville/issues"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/harbour/compress-assets.mjs && vite build",
    "harbour:compress": "node scripts/harbour/compress-assets.mjs",
    "serve:dist": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:visual": "playwright test tests/visual/harbour-dom.spec.ts",
    "test:visual:dist": "playwright test tests/visual/harbour-dom.spec.ts --config=playwright.dist.config.ts",
    "test:visual:dist:dom": "playwright test tests/visual/harbour-dom.spec.ts --config=playwright.dist.config.ts --grep @visual-dom",
    "test:visual:dist:dom:firefox": "PHAROSVILLE_VISUAL_BROWSERS=\"firefox\" playwright test tests/visual/harbour-dom.spec.ts --config=playwright.dist.config.ts --grep @visual-dom",
    "test:visual:cross-browser": "PHAROSVILLE_VISUAL_BROWSERS=\"chromium,firefox\" playwright test tests/visual/harbour-dom.spec.ts --grep @visual-accessibility",
    "test:visual:dist:accessibility": "PHAROSVILLE_VISUAL_BROWSERS=\"chromium,firefox\" playwright test tests/visual/harbour-dom.spec.ts --config=playwright.dist.config.ts --grep @visual-accessibility",
    "test:visual:dist:accessibility:firefox": "PHAROSVILLE_VISUAL_BROWSERS=\"firefox\" playwright test tests/visual/harbour-dom.spec.ts --config=playwright.dist.config.ts --grep @visual-accessibility",
    "onboard:agent": "node scripts/pharosville/onboard-agent.mjs",
    "agent:init": "node scripts/pharosville/agent-init.mjs",
    "setup:local-api-key": "node scripts/pharosville/setup-local-api-key.mjs",
    "smoke:api-local": "node scripts/pharosville/smoke-local-api.mjs",
    "smoke:dev-proxy": "node scripts/pharosville/smoke-dev-proxy.mjs",
    "worktree:new": "node scripts/pharosville/new-worktree.mjs",
    "agent:plan:new": "node scripts/pharosville/new-agent-plan.mjs",
    "validate:changed": "node scripts/pharosville/validate-changed.mjs",
    "validate:deploy-gate": "node scripts/pharosville/validate-deploy-gate.mjs",
    "check:harbour-contracts": "node scripts/harbour/check-civic-contract.mjs",
    "check:runtime-media": "node scripts/pharosville/validate-runtime-media.mjs",
    "check:pharos-watch-sync": "node scripts/harbour/sync-check.mjs",
    "sync:pharos-watch": "node scripts/harbour/sync-pharos-watch.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:committed-secrets": "node scripts/check-committed-secrets.mjs",
    "check:branch-protection": "node scripts/pharosville/check-branch-protection.mjs",
    "check:release-credentials": "node scripts/pharosville/check-release-credentials.mjs",
    "check:release-contract": "node scripts/pharosville/release-contract.mjs check",
    "check:github-releases": "node scripts/pharosville/release-contract.mjs audit-github --repo TokenBrice/pharosville",
    "check:security-headers": "node scripts/pharosville/check-security-headers.mjs --url https://pharosville.pharos.watch",
    "check:security-headers:static": "node scripts/pharosville/check-security-headers.mjs --static",
    "check:doc-paths-and-scripts": "node scripts/check-doc-paths-and-scripts.mjs",
    "docs:runtime-facts": "node scripts/pharosville/generate-runtime-facts.mjs",
    "check:runtime-facts": "node scripts/pharosville/generate-runtime-facts.mjs --check",
    "check:viewport-gate": "node scripts/check-viewport-gate.mjs",
    "test:guard-scripts": "node scripts/check-guards.test.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "smoke:live": "node scripts/smoke-live.mjs",
    "check:release-admin": "npm run check:branch-protection && npm run check:release-credentials && npm run check:github-releases",
    "check:release-readiness": "npm run check:security-headers && npm run test:visual:cross-browser && npm run test:visual:dist:accessibility && npm run smoke:live -- --url https://pharosville.pharos.watch",
    "validate:docs": "npm run test:guard-scripts && npm run check:doc-paths-and-scripts && npm run check:release-contract && npm run check:runtime-facts && npm run check:viewport-gate && npm run check:security-headers:static && npm run check:pharos-watch-sync",
    "validate": "npm run check:committed-secrets && npm run validate:docs && npm run check:runtime-media && npm run check:harbour-contracts && npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle-size && npm run perf:bytes",
    "validate:release": "npm run validate:deploy-gate && npm run lint && npm run check:viewport-gate",
    "deploy": "wrangler pages deploy dist --project-name=pharosville",
    "preview": "node scripts/harbour/shot.mjs",
    "perf:origin": "node scripts/perf/origin.mjs",
    "perf:load": "node scripts/perf/load.mjs",
    "perf:bytes": "node scripts/perf/first-frame-bytes.mjs",
    "perf:frame": "node scripts/perf/frame.mjs",
    "perf:golden": "node scripts/perf/golden.mjs",
    "perf:soak": "node scripts/perf/soak.mjs",
    "perf:compare": "node scripts/perf/compare.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "lucide-react": "1.47.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsdom": "29.1.1",
    "meshoptimizer": "1.2.0",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "terser": "5.51.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.5",
    "wrangler": "4.134.0"
  }
}
