{
  "name": "pharosville",
  "version": "0.1.0",
  "description": "Three.js maritime observatory for live Pharos stablecoin market signals.",
  "private": true,
  "license": "MIT",
  "homepage": "https://pharosville.pharos.watch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenBrice/pharosville.git"
  },
  "bugs": {
    "url": "https://github.com/TokenBrice/pharosville/issues"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve:dist": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:visual": "playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts",
    "test:visual:no-reuse": "PHAROSVILLE_VISUAL_REUSE=0 playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts",
    "test:visual:dist": "playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts",
    "test:visual:dist:static": "playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts --grep @visual-static",
    "test:visual:dist:interaction": "playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts --grep @visual-interaction",
    "test:visual:dist:dom": "playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts --grep @visual-dom",
    "test:visual:dist:dom:firefox": "PHAROSVILLE_VISUAL_BROWSERS=\"firefox\" playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts --grep @visual-dom",
    "test:visual:dist:motion": "playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts --grep @visual-motion",
    "test:perf": "playwright test tests/visual/pharosville-performance.spec.ts --workers=1",
    "test:perf:reference": "PHAROSVILLE_REFERENCE_GATE=1 PHAROSVILLE_VISUAL_BROWSERS=chromium PHAROSVILLE_VISUAL_REUSE=0 playwright test tests/visual/pharosville-performance.spec.ts --headed --workers=1",
    "test:visual:accessibility": "playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --grep @visual-accessibility",
    "test:visual:cross-browser": "PHAROSVILLE_VISUAL_BROWSERS=\"chromium,firefox\" playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --grep @visual-accessibility",
    "test:visual:dist:accessibility": "PHAROSVILLE_VISUAL_BROWSERS=\"chromium,firefox\" playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts --grep @visual-accessibility",
    "test:visual:dist:accessibility:firefox": "PHAROSVILLE_VISUAL_BROWSERS=\"firefox\" playwright test tests/visual/pharosville.spec.ts tests/visual/pharosville-gates.spec.ts --config=playwright.dist.config.ts --grep @visual-accessibility",
    "onboard:agent": "node scripts/pharosville/onboard-agent.mjs",
    "agent:init": "node scripts/pharosville/agent-init.mjs",
    "setup:local-api-key": "node scripts/pharosville/setup-local-api-key.mjs",
    "smoke:api-local": "node scripts/pharosville/smoke-local-api.mjs",
    "smoke:dev-proxy": "node scripts/pharosville/smoke-dev-proxy.mjs",
    "worktree:new": "node scripts/pharosville/new-worktree.mjs",
    "agent:plan:new": "node scripts/pharosville/new-agent-plan.mjs",
    "validate:changed": "node scripts/pharosville/validate-changed.mjs",
    "validate:deploy-gate": "node scripts/pharosville/validate-deploy-gate.mjs",
    "check:runtime-media": "node scripts/pharosville/validate-runtime-media.mjs && npm run check:garden-models",
    "check:garden-models": "node scripts/pharosville/generate-garden-lighthouse.mjs --check && node scripts/pharosville/generate-garden-heroes.mjs --check",
    "check:pharosville-colors": "node scripts/check-pharosville-colors.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:committed-secrets": "node scripts/check-committed-secrets.mjs",
    "check:branch-protection": "node scripts/pharosville/check-branch-protection.mjs",
    "check:release-credentials": "node scripts/pharosville/check-release-credentials.mjs",
    "check:release-contract": "node scripts/pharosville/release-contract.mjs check",
    "check:github-releases": "node scripts/pharosville/release-contract.mjs audit-github --repo TokenBrice/pharosville",
    "check:security-headers": "node scripts/pharosville/check-security-headers.mjs --url https://pharosville.pharos.watch",
    "check:security-headers:static": "node scripts/pharosville/check-security-headers.mjs --static",
    "check:doc-paths-and-scripts": "node scripts/check-doc-paths-and-scripts.mjs",
    "docs:runtime-facts": "node scripts/pharosville/generate-runtime-facts.mjs",
    "check:runtime-facts": "node scripts/pharosville/generate-runtime-facts.mjs --check",
    "check:viewport-gate": "node scripts/check-viewport-gate.mjs",
    "test:guard-scripts": "node scripts/check-guards.test.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "smoke:live": "node scripts/smoke-live.mjs",
    "check:release-admin": "npm run check:branch-protection && npm run check:release-credentials && npm run check:github-releases",
    "check:release-readiness": "npm run check:security-headers && npm run test:visual:cross-browser && npm run test:visual:dist:accessibility && npm run smoke:live -- --url https://pharosville.pharos.watch",
    "validate:docs": "npm run test:guard-scripts && npm run check:doc-paths-and-scripts && npm run check:release-contract && npm run check:runtime-facts && npm run check:viewport-gate && npm run check:security-headers:static",
    "validate": "npm run check:committed-secrets && npm run validate:docs && npm run check:runtime-media && npm run check:pharosville-colors && npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle-size",
    "validate:release": "npm run validate:deploy-gate && npm run lint && npm run check:viewport-gate",
    "deploy": "wrangler pages deploy dist --project-name=pharosville",
    "capture:triptych": "PHAROSVILLE_TRIPTYCH=1 playwright test tests/visual/pharosville-triptych.spec.ts --project=desktop-chromium",
    "preview": "node scripts/pharosville/preview.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.28.0",
    "n8ao": "2.0.0",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "meshoptimizer": "1.2.0",
    "playwright": "1.62.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "wrangler": "4.116.0"
  }
}
