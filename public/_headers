/*
  Security policy for PharosVille static assets and app shell.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), clipboard-read=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(self), serial=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: blob: https://www.google-analytics.com; style-src 'self'; script-src 'self' 'sha256-0hEr4TXvzJFsGiEhp4oxW03pt03dBoPdFJfflV++rLs=' 'wasm-unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://static.cloudflareinsights.com; frame-ancestors 'none'; form-action 'self'

# Vite emits hashed filenames into /assets/, so these are safe to long-cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Runtime GLBs use a content-hash query from the checked model manifest.
/pharosville/models/*
  Cache-Control: public, max-age=31536000, immutable

# The generated water normal uses a content-hash query in the runtime URL.
/pharosville/textures/*
  Cache-Control: public, max-age=31536000, immutable

# Fleet logos are id-prefixed but not content-hashed, so a day is the longest
# they can be cached and still let a replaced mark propagate.
/logos/*
  Cache-Control: public, max-age=86400

# Chain marks are vendored under stable filenames, so they take the same
# one-day ceiling as the fleet logos.
/chains/*
  Cache-Control: public, max-age=86400

# Publish the accepted garden edition atomically with its stills; never hold
# an old publication marker across releases.
/pharosville/stills/garden-social.json
  Cache-Control: no-cache
